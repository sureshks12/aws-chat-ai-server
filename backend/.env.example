# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/aws_chat_db?schema=public"

# Authentication Security
JWT_SECRET="super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Data Encryption Security (AES-256 key for secret AWS key storage)
ENCRYPTION_KEY="your-32-byte-encryption-secret-key-change-this"

# Gemini AI API Configuration
GEMINI_API_KEY="your-google-gemini-api-key"
